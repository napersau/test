# Sao chép thành .env rồi điền giá trị. KHÔNG commit file .env.
MYSQL_ROOT_PASSWORD=vetclinic_dev
RABBITMQ_USERNAME=vetclinic
RABBITMQ_PASSWORD=vetclinic_dev
# Khóa HMAC-SHA256 dùng chung cho auth-service và api-gateway, tối thiểu 32 byte.
# Sinh ngẫu nhiên: openssl rand -hex 32
JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
